---
import "@/styles/global.css";
import { dir, isLang, LANG_NAMES, LANGS, t, type Lang } from "@/lib/i18n";
import { currentUser } from "@/lib/auth";
import { avatarOf } from "@/lib/db";
import { SITE_URL, CONTENT_REVIEWED } from "@/lib/site";
import Nav from "@/components/Nav.astro";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;      // pages privées (compte, formulaire, connexion)
  canonical?: string;     // chemin canonique, sinon l'URL courante
  alternates?: Record<string, string>;
  footer?: boolean;       // pied de page (masqué dans l'espace patient)
  wrap?: boolean;         // enveloppe le contenu dans .wrap (toutes les pages sauf l'accueil)
  nav?: boolean;
  reviewed?: boolean;     // fiche relue par un médecin (admin) : indexable même sans CONTENT_REVIEWED          // barre de navigation (absente dans l'espace patient, qui a sa barre latérale)
}
const { lang, title, description, noindex = false, canonical, alternates, wrap = true, footer = true, nav = true, reviewed = false } = Astro.props;
const user = await currentUser(Astro.cookies);
const fullTitle = title ? `${title} | Wedicine` : `Wedicine, ${t(lang, "tagline")}`;
const desc = description ?? t(lang, "heroSub");
const canon = `${SITE_URL}${canonical ?? Astro.url.pathname}`;
// Tant qu'un médecin n'a pas relu le contenu, rien n'est indexé.
const robots = noindex || !(CONTENT_REVIEWED || reviewed) ? "noindex, follow" : "index, follow";
import { isAdmin } from "@/lib/admin";
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canon} />
    {alternates && Object.entries(alternates).map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canon} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Thème avant l'affichage (pas de flash) : choix gardé, sinon réglage du système.
      try { var th = localStorage.getItem("wd-theme"); if (!th) th = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={lang === "ar" ? "/fonts/tajawal-400.woff2" : "/fonts/nunito-sans.woff2"} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    {nav && <Nav lang={lang} user={user ? { firstName: user.first_name, lastName: user.last_name, avatar: avatarOf(user), admin: isAdmin(user) } : null} />}
    <main>
      {wrap ? <div class="wrap page"><slot /></div> : <slot />}
    </main>
    {footer && (
    <div class="mini-foot" role="contentinfo">
      <div class="wrap chat-legal">
        <span>{t(lang, "emergencyLine")} {t(lang, "notDoctor")} · {t(lang, "footerLegal")} · <a href={`/${lang}/contact`}>{t(lang, "contactUs")}</a></span>
      </div>
    </div>
    )}
    {!Astro.url.pathname.startsWith("/admin") && (
      <script is:inline>
        // Temps passé (mesure d'audience sans donnée personnelle) : un signal toutes les 15 s quand la page est visible.
        setInterval(function () { if (document.visibilityState === "visible") { try { navigator.sendBeacon("/api/t"); } catch (e) {} } }, 15000);
      </script>
    )}
    <script>
      // Ombre de la barre de navigation dès que la page défile.
      const nav = document.querySelector(".nav");
      const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 8);
      onScroll(); addEventListener("scroll", onScroll, { passive: true });
      // Apparition des sections au défilement (désactivée si l'utilisateur réduit les animations).
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = document.querySelectorAll(".reveal, .reveal-stagger");
      if (reduce || !("IntersectionObserver" in window)) els.forEach((e) => e.classList.add("in"));
      else {
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); }
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.1 });
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>
