---
// Gabarit de l'espace patient (inspiré de doctolib.fr) : menu latéral à gauche, une rubrique par page.
// Sur mobile, le menu devient une rangée d'onglets défilante en haut de page.
import Base from "@/layouts/Base.astro";
import { t, type Lang, type UIKey } from "@/lib/i18n";
import { ACCOUNT_PAGES, type AccountPage } from "@/lib/account";
import { Icon } from "@/components/Icon";

interface Props { lang: Lang; active: AccountPage; title: string; name: string; avatar: string }
const { lang, active, title, name, avatar } = Astro.props;
---
<Base lang={lang} title={title} noindex wrap={false}>
  <div class="acc-shell">
    <aside class="acc-side" aria-label={t(lang, "myAccount")}>
      <nav class="acc-menu">
        {ACCOUNT_PAGES.map((p) => (
          <a href={`/${lang}/compte${p.id ? `/${p.id}` : ""}`} aria-current={p.id === active ? "page" : undefined}>
            <Icon name={p.icon} size={20} /><span>{t(lang, p.key as UIKey)}</span>
          </a>
        ))}
        <a href={`/api/logout?lang=${lang}`} class="logout" rel="nofollow"><Icon name="LogOut" size={20} /><span>{t(lang, "logout")}</span></a>
      </nav>
    </aside>
    <div class="acc-main">
      <h1 class="acc-title">{title}</h1>
      <slot />
    </div>
  </div>
</Base>
