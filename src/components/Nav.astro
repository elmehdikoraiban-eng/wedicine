---
import { LANG_NAMES, LANGS, t, type Lang, type UIKey } from "@/lib/i18n";
import { ACCOUNT_PAGES } from "@/lib/account";
import { Icon } from "./Icon";

interface Props { lang: Lang; user: { firstName: string; lastName: string; avatar: number } | null }
const { lang, user } = Astro.props;
// Langue choisie automatiquement (navigateur) ; on peut la changer dans le menu du compte ou le pied de page, sur la même page.
const rest = Astro.url.pathname.replace(/^\/(fr|ar|en)(?=\/|$)/, "");
---
<header class="nav">
  <div class="wrap">
    <a href={`/${lang}`} class="logo" aria-label="Wedicine">
      <img class="logo-full" src="/brand/logo.svg" alt="" width="168" height="30" />
      <img class="logo-mark" src="/brand/symbole.svg" alt="" width="40" height="40" />
    </a>
    <nav class="nav-links" aria-label="Navigation">
      {user
        ? (
          <details class="me-menu">
            <summary aria-label={t(lang, "myAccount")}>
              <img src={`/avatars/${String(user.avatar).padStart(2, "0")}.svg`} alt="" width="36" height="36" />
              <span class="hide-sm">{user.firstName}</span>
              <Icon name="ChevronDown" size={16} />
            </summary>
            <div class="me-pop">
              <div class="me-head">
                <img src={`/avatars/${String(user.avatar).padStart(2, "0")}.svg`} alt="" width="44" height="44" />
                <span><b>{user.firstName} {user.lastName}</b><a href={`/${lang}/compte`}>{t(lang, "myAccount")}</a></span>
              </div>
              {ACCOUNT_PAGES.filter((p) => p.id).map((p) => (
                <a href={`/${lang}/compte/${p.id}`}><Icon name={p.icon} size={18} />{t(lang, p.key as UIKey)}</a>
              ))}
              <div class="me-lang">
                <span class="muted small"><Icon name="Globe" size={16} /> {t(lang, "accLanguage")}</span>
                <div>{LANGS.map((l) => <a href={`/${l}${rest}`} aria-current={l === lang ? "true" : undefined} lang={l}>{LANG_NAMES[l]}</a>)}</div>
              </div>
              <a href={`/api/logout?lang=${lang}`} class="logout" rel="nofollow"><Icon name="LogOut" size={18} />{t(lang, "logout")}</a>
            </div>
          </details>
        )
        : <>
          <a href={`/${lang}/connexion`} class="plain">{t(lang, "login")}</a>
          <a href={`/${lang}/connexion?mode=inscription`} class="btn btn-primary btn-sm">{t(lang, "signup")}</a>
        </>}
    </nav>
  </div>
</header>

<script>
  // Menu avatar : se ferme au clic à l'extérieur ou avec Échap.
  const m = document.querySelector<HTMLDetailsElement>(".me-menu");
  if (m) {
    document.addEventListener("click", (e) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && m.open) { m.open = false; m.querySelector("summary")?.focus(); } });
  }
</script>
