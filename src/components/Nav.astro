---
import { LANG_NAMES, LANGS, t, type Lang, type UIKey } from "@/lib/i18n";
import { ACCOUNT_PAGES } from "@/lib/account";
import { Icon } from "./Icon";
import ThemePick from "./ThemePick.astro";

interface Props { lang: Lang; user: { firstName: string; lastName: string; avatar: number; admin?: boolean } | null }
const { lang, user } = Astro.props;
// Langue choisie automatiquement (navigateur) ; on peut la changer dans l'en-tête (bouton langue) ou le menu du compte, sur la même page.
const rest = Astro.url.pathname.replace(/^\/(fr|ar|en)(?=\/|$)/, "");
---
<header class="nav">
  <div class="wrap">
    <a href={`/${lang}`} class="logo" aria-label="Wedicine">
      <img class="logo-full logo-light" src="/brand/logo.svg" alt="" width="204" height="36" />
      <img class="logo-full logo-dark" src="/brand/logo-sombre.svg" alt="" width="204" height="36" />
      <img class="logo-mark logo-light" src="/brand/symbole.svg" alt="" width="40" height="40" />
      <img class="logo-mark logo-dark" src="/brand/symbole-sombre.svg" alt="" width="40" height="40" />
    </a>
    <nav class="nav-links" aria-label="Navigation">
      {user
        ? (
          <details class="me-menu">
            <summary aria-label={t(lang, "myAccount")}>
              <img src={`/avatars/${String(user.avatar).padStart(2, "0")}.svg`} alt="" width="36" height="36" />
              <span class="hide-sm">{user.firstName}</span>
              <Icon name="ChevronDown" size={16} />
            </summary>
            <div class="me-pop">
              <div class="me-head">
                <img src={`/avatars/${String(user.avatar).padStart(2, "0")}.svg`} alt="" width="44" height="44" />
                <span><b>{user.firstName} {user.lastName}</b><a href={`/${lang}/compte`}>{t(lang, "myAccount")}</a></span>
              </div>
              {ACCOUNT_PAGES.filter((p) => p.id).map((p) => (
                <a href={`/${lang}/compte/${p.id}`}><Icon name={p.icon} size={18} />{t(lang, p.key as UIKey)}</a>
              ))}
              {user.admin && <a href="/admin"><Icon name="ChartColumn" size={18} />Admin</a>}
              <div class="me-lang">
                <span class="muted small"><Icon name="Globe" size={16} /> {t(lang, "accLanguage")}</span>
                <div>{LANGS.map((l) => <a href={`/${l}${rest}`} aria-current={l === lang ? "true" : undefined} lang={l}>{LANG_NAMES[l]}</a>)}</div>
              </div>
              <div class="me-theme"><ThemePick lang={lang} /></div>
              <a href={`/api/logout?lang=${lang}`} class="logout" rel="nofollow"><Icon name="LogOut" size={18} />{t(lang, "logout")}</a>
            </div>
          </details>
        )
        : <>
          <details class="lang-pick down">
            <summary aria-label={t(lang, "accLanguage")}><Icon name="Globe" size={15} /><span class="hide-sm">{LANG_NAMES[lang]}</span><Icon name="ChevronDown" size={14} /></summary>
            <div class="lang-pop">{LANGS.map((l) => <a href={`/${l}${rest}`} lang={l} aria-current={l === lang ? "true" : undefined}>{LANG_NAMES[l]}</a>)}</div>
          </details>
          <ThemePick lang={lang} />
          <a href={`/${lang}/connexion`} class="plain">{t(lang, "login")}</a>
          <a href={`/${lang}/inscription`} class="btn btn-primary btn-sm">{t(lang, "signup")}</a>
        </>}
    </nav>
  </div>
</header>

<script>
  // Bouton langue : se ferme au clic à l'extérieur.
  const lp = document.querySelector<HTMLDetailsElement>(".nav .lang-pick");
  if (lp) document.addEventListener("click", (e) => { if (lp.open && !lp.contains(e.target as Node)) lp.open = false; });
  // Menu avatar : se ferme au clic à l'extérieur ou avec Échap.
  const m = document.querySelector<HTMLDetailsElement>(".me-menu");
  if (m) {
    document.addEventListener("click", (e) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && m.open) { m.open = false; m.querySelector("summary")?.focus(); } });
  }
</script>
