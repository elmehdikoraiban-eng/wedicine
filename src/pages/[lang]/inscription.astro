---
import Base from "@/layouts/Base.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { currentUser } from "@/lib/auth";
import { AuthForm } from "@/components/AuthForm";
import { Icon } from "@/components/Icon";
import { PhoneForm, Account, AnswerSheet } from "@/components/Illustrations";
import { authContext } from "@/lib/authpage";

// Inscription, façon Claude : le formulaire en haut, puis « Comment ça marche » en trois étapes illustrées.
const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const sp = Astro.url.searchParams;
const user = await currentUser(Astro.cookies);
const c = await authContext(sp);
if (user) return Astro.redirect(c.unlock ? `/${lang}/compte/q/${c.qid}` : c.next ?? `/${lang}`, 302);
const steps = [
  { art: PhoneForm, title: "step1Title", text: "step1Text" },
  { art: Account, title: "step2Title", text: "step2Text" },
  { art: AnswerSheet, title: "step3Title", text: "step3Text" },
] as const;
---
<Base lang={lang} title={t(lang, "signup")} noindex>
  <div class="authx">
    <img src="/brand/symbole.svg" alt="" width="40" height="40" class="authx-sym logo-light" /><img src="/brand/symbole-sombre.svg" alt="" width="40" height="40" class="authx-sym logo-dark" />
    {c.unlock && <p class="authx-badge"><Icon name="Check" size={14} /> {t(lang, "previewReady")}</p>}
    <h1>{t(lang, "signupTitle")}</h1>
    <p class="authx-sub">{t(lang, "signupSub")}</p>
    <AuthForm client:load lang={lang} mode="signup" questionId={c.unlock ? c.qid : undefined} redirectTo={c.next} switchHref={`/${lang}/connexion${c.query}`} />
  </div>
  <section class="authx-how" aria-labelledby="how">
    <h2 id="how">{t(lang, "signupHow")}</h2>
    <ol>
      {steps.map((s) => { const Art = s.art; return (
        <li><Art className="authx-art" /><h3>{t(lang, s.title)}</h3><p>{t(lang, s.text)}</p></li>
      ); })}
    </ol>
  </section>
</Base>
