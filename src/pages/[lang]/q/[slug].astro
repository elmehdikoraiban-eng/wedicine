---
import Base from "@/layouts/Base.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { fiche } from "@/lib/content/fiches";
import { findPage, pageTitle } from "@/lib/content/themes";
import { AGES, CITIES, DURATIONS, INTENTS } from "@/lib/content/options";
import { countView, pageStats, publicAskers, type PageStats } from "@/lib/db";
import { publicName } from "@/lib/auth";
import { alternates, formatDate, qPath, SITE_URL, timeAgo } from "@/lib/site";
import { Answer, answerOutline } from "@/components/Answer";
import type { UIKey } from "@/lib/i18n";
import { Icon } from "@/components/Icon";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const page = findPage(lang, decodeURIComponent(Astro.params.slug ?? ""));
if (!page) return new Response(null, { status: 404 });
const { theme: th, symptom: sy, intent } = page;
const f = fiche(th.id, sy.id);
if (!f) return new Response(null, { status: 404 });

// La liste des patients change : page rendue à la demande.
const askers = await publicAskers(th.id, sy.id, intent).catch((e) => { console.error("publicAskers", e); return []; });
const empty: PageStats = { total: 0, lastAt: null, durations: [], ages: [], cities: [] };
const stats = await pageStats(th.id, sy.id).catch((e) => { console.error("pageStats", e); return empty; });
// Une vue = une personne qui lit la page (les robots ne comptent pas).
if (!/bot|crawl|spider|slurp|preview|lighthouse|headless/i.test(Astro.request.headers.get("user-agent") ?? "")) {
  await countView(th.id, sy.id, intent).catch(() => {});
}
const lbl = (list: { id: string; label: Record<string, string> }[], id: string) => list.find((o) => o.id === id)?.label[lang] ?? id;
const pct = (n: number) => `${Math.round((n / Math.max(stats.total, 1)) * 100)} %`;
const who = (p: { sex: string | null; who: string }) => p.who === "enfant" ? t(lang, "aParent") : p.sex === "f" ? t(lang, "aPatientF") : t(lang, "aPatientM");
const title = pageTitle(lang, th, sy, intent);
const it = INTENTS.find((i) => i.id === intent)!;
const path = qPath(lang, th, sy, intent);
const toc = [...answerOutline(intent), { id: "stats", key: "statsTitle" }, { id: "ils-ont-demande", key: "othersAsked" }, { id: "sujets-proches", key: "related" }];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: lang,
  url: `${SITE_URL}${path}`,
  about: { "@type": "MedicalSymptom", name: sy.label[lang] },
  audience: { "@type": "Patient" },
  mainEntity: { "@type": "Question", name: title, acceptedAnswer: { "@type": "Answer", text: f.summary[lang] } },
  publisher: { "@type": "Organization", name: "Wedicine", url: SITE_URL },
};
---
<Base lang={lang} title={title} description={f.summary[lang].slice(0, 160)} canonical={path} alternates={alternates(th, sy, intent)}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="read-layout">
    <nav class="toc" aria-label={t(lang, "tocTitle")}>
      <p class="toc-title">{t(lang, "tocTitle")}</p>
      <ol>{toc.map((x) => <li><a href={`#${x.id}`}>{t(lang, x.key as UIKey)}</a></li>)}</ol>
    </nav>
    <div class="read-main">
    <Answer lang={lang} fiche={f} th={th} sy={sy} intent={intent}>
      <section class="card sec stats-sec" id="stats" style="margin-top:16px">
        <h2><Icon name="ChartColumn" size={22} />{t(lang, "statsTitle")}</h2>
        {stats.total === 0 ? <p class="muted">{t(lang, "statsEmpty")}</p> : (
          <div class="stats-grid">
            <div class="stat big"><b>{stats.total}</b><span>{t(lang, stats.total === 1 ? "statsAskedOne" : "statsAsked")}</span></div>
            {stats.lastAt && <div class="stat"><Icon name="Clock" size={20} /><span class="muted small">{t(lang, "statsLast")}</span><b>{timeAgo(stats.lastAt, lang)}</b></div>}
            {stats.durations[0] && <div class="stat"><Icon name="Timer" size={20} /><span class="muted small">{t(lang, "statsDuration")}</span><b>{lbl(DURATIONS, stats.durations[0].id)}</b><span class="muted small">{pct(stats.durations[0].n)}</span></div>}
            {stats.ages.length > 0 && <div class="stat"><Icon name="Users" size={20} /><span class="muted small">{t(lang, "statsAges")}</span>
              {stats.ages.slice(0, 2).map((a) => <span class="bar-row"><span>{lbl(AGES, a.id)}</span><span class="bar"><i style={`width:${pct(a.n)}`}></i></span><span class="muted small">{pct(a.n)}</span></span>)}
            </div>}
            {stats.cities.length > 0 && <div class="stat"><Icon name="MapPin" size={20} /><span class="muted small">{t(lang, "statsCities")}</span>
              {stats.cities.slice(0, 3).map((c) => <span class="bar-row"><span>{lbl(CITIES, c.id)}</span><span class="bar"><i style={`width:${pct(c.n)}`}></i></span><span class="muted small">{pct(c.n)}</span></span>)}
            </div>}
          </div>
        )}
        <p class="muted small" style="margin:12px 0 0">{t(lang, "anonCountLine")}</p>
      </section>
      <section class="card sec" id="ils-ont-demande" style="margin-top:16px">
        <h2><Icon name="Users" size={22} />{t(lang, "othersAsked")}</h2>
        {askers.length === 0 ? <p class="muted">—</p> : (
          <div class="askers">
            {askers.map((p) => (
              <span class="asker">
                <b>{p.anonymous ? who(p) : publicName(p.first_name, p.last_name)}</b>
                {p.age && <>, {AGES.find((x) => x.id === p.age)?.label[lang]}</>}
                {p.city && p.city !== "autre" && <>, {CITIES.find((x) => x.id === p.city)?.label[lang]}</>}
                <span class="muted"> · {formatDate(p.created_at, lang)}</span>
              </span>
            ))}
          </div>
        )}
        <p style="margin:16px 0 0">
          <a href={`/${lang}/question?theme=${th.id}`} class="btn btn-primary"><Icon name={it.icon ?? "ArrowRight"} size={18} /> {t(lang, "start")}</a>
        </p>
      </section>
    </Answer>
    </div>
  </div>
</Base>

<script>
  // Sommaire : surligne la rubrique en cours de lecture.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".toc a")].map((a) => [a.hash.slice(1), a]));
  const seen = new Set<string>();
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id);
    const first = [...links.keys()].find((id) => seen.has(id));
    if (first) links.forEach((a, id) => a.toggleAttribute("aria-current", id === first));
  }, { rootMargin: "-90px 0px -65% 0px" });
  links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
</script>
