---
import Base from "@/layouts/Base.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { fiche } from "@/lib/content/fiches";
import { findPage, pageTitle } from "@/lib/content/themes";
import { AGES, CITIES, INTENTS } from "@/lib/content/options";
import { publicAskers } from "@/lib/db";
import { publicName } from "@/lib/auth";
import { alternates, formatDate, qPath, SITE_URL } from "@/lib/site";
import { Answer } from "@/components/Answer";
import { Icon } from "@/components/Icon";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const page = findPage(lang, decodeURIComponent(Astro.params.slug ?? ""));
if (!page) return new Response(null, { status: 404 });
const { theme: th, symptom: sy, intent } = page;
const f = fiche(th.id, sy.id);
if (!f) return new Response(null, { status: 404 });

// La liste des patients change : page rendue à la demande.
const askers = await publicAskers(th.id, sy.id, intent).catch(() => []);
const title = pageTitle(lang, th, sy, intent);
const it = INTENTS.find((i) => i.id === intent)!;
const path = qPath(lang, th, sy, intent);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: title,
  inLanguage: lang,
  url: `${SITE_URL}${path}`,
  about: { "@type": "MedicalSymptom", name: sy.label[lang] },
  audience: { "@type": "Patient" },
  mainEntity: { "@type": "Question", name: title, acceptedAnswer: { "@type": "Answer", text: f.summary[lang] } },
  publisher: { "@type": "Organization", name: "Wedicine", url: SITE_URL },
};
---
<Base lang={lang} title={title} description={f.summary[lang].slice(0, 160)} canonical={path} alternates={alternates(th, sy, intent)}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="narrow">
    <Answer lang={lang} fiche={f} th={th} sy={sy} intent={intent}>
      <section class="card sec" style="margin-top:16px">
        <h2><Icon name="Users" size={22} />{t(lang, "othersAsked")}</h2>
        {askers.length === 0 ? <p class="muted">—</p> : (
          <div class="askers">
            {askers.map((p) => (
              <span class="asker">
                <b>{publicName(p.first_name, p.last_name)}</b>
                {p.age && <>, {AGES.find((x) => x.id === p.age)?.label[lang]}</>}
                {p.city && p.city !== "autre" && <>, {CITIES.find((x) => x.id === p.city)?.label[lang]}</>}
                <span class="muted"> · {formatDate(p.created_at, lang)}</span>
              </span>
            ))}
          </div>
        )}
        <p style="margin:16px 0 0">
          <a href={`/${lang}/question?theme=${th.id}`} class="btn btn-primary"><Icon name={it.icon ?? "ArrowRight"} size={18} /> {t(lang, "start")}</a>
        </p>
      </section>
    </Answer>
  </div>
</Base>
