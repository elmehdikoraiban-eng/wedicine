---
import Account from "@/layouts/Account.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { loadAccount } from "@/lib/account";
import { Icon } from "@/components/Icon";
import { TopicScene } from "@/components/TopicScenes";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const a = await loadAccount(Astro, lang);
if (!a) return Astro.redirect(`/${lang}/connexion`, 302);
---
<Account lang={lang} active="sante" title={t(lang, "accHealth")} name={`${a.acc.first_name} ${a.acc.last_name}`} avatar={a.avatar}>
  <section class="acc-card">
    {a.health.length
      ? <>
          <div class="acc-tiles">
            {a.health.map((h) => <div class="acc-tile"><Icon name={h.icon} size={24} /><span class="muted small">{h.k}</span><b>{h.v}</b></div>)}
          </div>
          <p class="muted small">{t(lang, "accHealthHint")}</p>
        </>
      : <p class="muted">{t(lang, "accHealthEmpty")}</p>}
  </section>
  {a.topics.length > 0 && (
    <section class="acc-section">
      <h2>{t(lang, "accTopics")}</h2>
      <div class="acc-topics">
        {a.topics.map((th) => <a href={`/${lang}/question?theme=${th.id}`} class="topic-card"><TopicScene id={th.id} /><span class="topic-name">{th.label[lang]}</span></a>)}
      </div>
    </section>
  )}
</Account>
