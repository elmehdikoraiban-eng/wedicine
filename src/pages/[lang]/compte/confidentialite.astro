---
import Account from "@/layouts/Account.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { loadAccount } from "@/lib/account";
import { formatDate } from "@/lib/site";
import { Icon } from "@/components/Icon";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const a = await loadAccount(Astro, lang);
if (!a) return Astro.redirect(`/${lang}/connexion`, 302);
---
<Account lang={lang} active="confidentialite" title={t(lang, "accPrivacyTitle")} name={a.shortName} avatar={a.avatar} recent={a.recent}>
  <section class="acc-card acc-consents">
    <h2><Icon name="ShieldCheck" size={22} /> {t(lang, "accConsents")}</h2>
    <ul>
      <li><Icon name="Check" size={18} /> {t(lang, "accConsentInfo")} {formatDate(a.acc.consent_info_at, lang)}</li>
      <li><Icon name="Check" size={18} /> {t(lang, "accConsentTerms")} {formatDate(a.acc.consent_terms_at, lang)}</li>
    </ul>
  </section>
  <section class="acc-card acc-consents">
    <h2><Icon name="Globe" size={22} /> {t(lang, "accPublicTitle")}</h2>
    <p>{t(lang, "accPrivacy")}</p>
    <p class="muted">{a.nPub} / {a.qs.length} · {t(lang, "accPublicHint")}</p>
    <a href={`/${lang}/compte/questions`} class="btn btn-ghost">{t(lang, "myQuestions")}</a>
  </section>
</Account>
