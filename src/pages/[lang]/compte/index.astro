---
import Account from "@/layouts/Account.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { loadAccount, ACCOUNT_PAGES } from "@/lib/account";
import { pageTitle } from "@/lib/content/themes";
import { formatDate } from "@/lib/site";
import { Icon } from "@/components/Icon";
import QuestionRow from "@/components/QuestionRow.astro";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const a = await loadAccount(Astro, lang);
if (!a) return Astro.redirect(`/${lang}/connexion`, 302);
const tiles = ACCOUNT_PAGES.filter((p) => p.id);
const DESC = { questions: "accQuestionsDesc", infos: "accIdentityDesc", sante: "accHealthDesc", confidentialite: "accPrivacyDesc" } as const;
---
<Account lang={lang} active="" title={`${t(lang, "hello")} ${a.acc.first_name}`} name={`${a.acc.first_name} ${a.acc.last_name}`} avatar={a.avatar}>
  <p class="muted acc-lead">{t(lang, "memberSince")} {formatDate(a.acc.created_at, lang)}</p>
  <div class="acc-stats">
    {a.stats.map((s) => <a href={`/${lang}/compte/${s.href}`}><b>{s.n}</b><span>{s.k}</span></a>)}
  </div>
  <div class="acc-shortcuts">
    {tiles.map((p) => (
      <a href={`/${lang}/compte/${p.id}`} class="acc-shortcut">
        <span class="ico"><Icon name={p.icon} size={24} /></span>
        <span><b>{t(lang, p.key)}</b><span class="muted small">{t(lang, DESC[p.id as keyof typeof DESC])}</span></span>
        <Icon name={lang === "ar" ? "ArrowLeft" : "ArrowRight"} size={18} />
      </a>
    ))}
  </div>
  {a.qs.length > 0 && (
    <section class="acc-section">
      <div class="acc-section-head">
        <h2>{t(lang, "accLatest")}</h2>
        <a href={`/${lang}/compte/questions`} class="link-ul">{t(lang, "accSeeAll")}</a>
      </div>
      <div class="qlist">{a.qs.slice(0, 3).map((x) => <QuestionRow lang={lang} {...x} />)}</div>
    </section>
  )}
  <p><a href={`/${lang}/question`} class="btn btn-primary">{t(lang, "newQuestion")}</a></p>
</Account>
