---
// Mon compte est une fenêtre (popup) ouverte par-dessus la page en cours (voir AccountModal.astro).
// Cette adresse reste pour les anciens liens : elle ouvre l'accueil avec la fenêtre ouverte.
import { langParam } from "@/lib/lang";
import { currentUser } from "@/lib/auth";
const lang = langParam(Astro.params) ?? "fr";
const hash = ["infos", "sante", "confidentialite", "donnees"].includes(Astro.url.searchParams.get("r") ?? "") ? Astro.url.searchParams.get("r") : "infos";
if (!(await currentUser(Astro.cookies))) return Astro.redirect(`/${lang}/connexion`, 302);
return Astro.redirect(`/${lang}#${hash}`, 302);
---
