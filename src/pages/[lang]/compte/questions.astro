---
import Account from "@/layouts/Account.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { loadAccount } from "@/lib/account";
import QuestionRow from "@/components/QuestionRow.astro";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const a = await loadAccount(Astro, lang);
if (!a) return Astro.redirect(`/${lang}/connexion`, 302);
const mine = a.qs.filter(({ q }) => q.who === "moi");
const others = a.qs.filter(({ q }) => q.who !== "moi");
---
<Account lang={lang} active="questions" title={t(lang, "myQuestions")} name={`${a.acc.first_name} ${a.acc.last_name}`} avatar={a.avatar}>
  {a.qs.length === 0 && <p class="card">{t(lang, "noQuestions")}</p>}
  {mine.length > 0 && <section class="acc-section"><h2>{t(lang, "accForMe")}</h2><div class="qlist">{mine.map((x) => <QuestionRow lang={lang} {...x} />)}</div></section>}
  {others.length > 0 && <section class="acc-section"><h2>{t(lang, "accForOthers")}</h2><div class="qlist">{others.map((x) => <QuestionRow lang={lang} {...x} />)}</div></section>}
  <p><a href={`/${lang}/question`} class="btn btn-primary">{t(lang, "newQuestion")}</a></p>
</Account>
