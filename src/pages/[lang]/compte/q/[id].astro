---
import Base from "@/layouts/Base.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { currentUser } from "@/lib/auth";
import { questionById } from "@/lib/db";
import { fiche } from "@/lib/content/fiches";
import { symptom, theme } from "@/lib/content/themes";
import { caseLines } from "@/lib/case";
import { qPath } from "@/lib/site";
import { Answer } from "@/components/Answer";
import { PublishToggle } from "@/components/PublishToggle";
import { Icon } from "@/components/Icon";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const id = Number(Astro.params.id);
const user = await currentUser(Astro.cookies);
if (!user) return Astro.redirect(`/${lang}/connexion?next=/${lang}/compte/q/${id}`, 302);
const q = Number.isInteger(id) ? await questionById(id) : undefined;
if (!q || q.user_id !== user.id) return new Response(null, { status: 404 });
const th = theme(q.theme); const sy = th && symptom(th, q.symptom); const f = th && sy && fiche(th.id, sy.id);
if (!th || !sy || !f) return new Response(null, { status: 404 });
const lines = q.urgent ? [] : caseLines({ ...q, intensity: q.intensity == null ? null : String(q.intensity) }, lang);
---
<Base lang={lang} title={t(lang, "myQuestions")} noindex>
  {q.urgent ? (
    <div class="urgent">
      <div class="big"><Icon name="Siren" size={44} /></div>
      <h1>{t(lang, "urgentTitle")}</h1>
      <p class="muted">{t(lang, "urgentText")}</p>
      <div class="calls">
        <a href="tel:15" class="btn btn-danger btn-lg"><Icon name="Phone" size={22} /> {t(lang, "call15")}</a>
        <a href="tel:141" class="btn btn-danger btn-lg"><Icon name="Phone" size={22} /> {t(lang, "call141")}</a>
      </div>
    </div>
  ) : (
    <div class="narrow">
      <p class="no-print"><a href={`/${lang}/compte`}>← {t(lang, "myQuestions")}</a></p>
      <Answer lang={lang} fiche={f} th={th} sy={sy} intent={q.intent} caseLines={lines}>
        <section class="card no-print" style="margin-top:16px">
          <PublishToggle client:load lang={lang} id={q.id} isPublic={q.is_public} />
          <p class="muted small" style="margin:10px 0 0">{t(lang, "consentPublish")}</p>
          <div class="row" style="margin-top:12px">
            <a href={qPath(lang, th, sy, q.intent)} class="btn btn-ghost btn-sm"><Icon name="Globe" size={16} /> {t(lang, "publicPage")}</a>
            <a href={`/${lang}/question`} class="btn btn-ghost btn-sm">{t(lang, "newQuestion")}</a>
          </div>
        </section>
      </Answer>
    </div>
  )}
</Base>
