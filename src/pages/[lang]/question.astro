---
// L'accueil est devenu la conversation : cette adresse (encore liée depuis l'espace patient) y renvoie, sujet compris.
import { langParam } from "@/lib/lang";
import { theme } from "@/lib/content/themes";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const th = Astro.url.searchParams.get("theme") ?? "";
return Astro.redirect(`/${lang}${theme(th) ? `?theme=${th}` : ""}`, 302);
---
