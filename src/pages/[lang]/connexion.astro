---
import Base from "@/layouts/Base.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { currentUser } from "@/lib/auth";
import { AuthForm } from "@/components/AuthForm";
import { Icon } from "@/components/Icon";
import { authContext } from "@/lib/authpage";

// Connexion, façon Claude : le symbole, un titre, deux champs, un bouton. Rien d'autre.
// ?q=ID : la question vient d'être posée, la connexion ouvre sa réponse.
const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
const sp = Astro.url.searchParams;
// Ancien lien « ?mode=inscription » : la création de compte a maintenant sa propre page.
if (sp.get("mode") === "inscription") { sp.delete("mode"); return Astro.redirect(`/${lang}/inscription${sp.size ? `?${sp}` : ""}`, 302); }
const user = await currentUser(Astro.cookies);
const c = await authContext(sp);
if (user) return Astro.redirect(c.unlock ? `/${lang}/compte/q/${c.qid}` : c.next ?? `/${lang}`, 302);
---
<Base lang={lang} title={t(lang, "login")} noindex>
  <div class="authx">
    <img src="/brand/symbole.svg" alt="" width="40" height="40" class="authx-sym" />
    {c.unlock && <p class="authx-badge"><Icon name="Check" size={14} /> {t(lang, "previewReady")}</p>}
    <h1>{t(lang, "loginTitle")}</h1>
    <AuthForm client:load lang={lang} mode="login" questionId={c.unlock ? c.qid : undefined} redirectTo={c.next} switchHref={`/${lang}/inscription${c.query}`} />
  </div>
</Base>
