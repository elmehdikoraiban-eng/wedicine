---
import Base from "@/layouts/Base.astro";
import { langParam } from "@/lib/lang";
import { theme } from "@/lib/content/themes";
import { SITE_URL } from "@/lib/site";
import { Chat } from "@/components/Chat";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
// L'accueil est la conversation elle-même : la première question est posée tout de suite, sans compte.
// ?theme=fievre (liens des pages publiques et du pied de page) répond d'avance à « De quoi s'agit-il ? ».
const th = Astro.url.searchParams.get("theme") ?? "";
const initialTheme = theme(th) ? th : undefined;
const alternates = { fr: `${SITE_URL}/fr`, ar: `${SITE_URL}/ar`, en: `${SITE_URL}/en`, "x-default": `${SITE_URL}/fr` };
---
<Base lang={lang} canonical={`/${lang}`} alternates={alternates} wrap={false} footer={false}>
  <Chat client:load lang={lang} initialTheme={initialTheme} />
</Base>
