---
import Base from "@/layouts/Base.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { pageTitle, THEMES } from "@/lib/content/themes";
import { qPath, SITE_URL } from "@/lib/site";
import { Icon } from "@/components/Icon";
import { Account, AnswerSheet, Choose, Community, DurationTimeline, PhoneForm, ThemeArt, Urgent } from "@/components/Illustrations";
import { fiche } from "@/lib/content/fiches";
import { DURATIONS } from "@/lib/content/options";
import { countQuestions } from "@/lib/db";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);

// Quelques questions mises en avant sur l'accueil (thème, symptôme, intention).
const POPULAR: [string, string, string][] = [
  ["fievre", "seule", "grave"], ["tete", "migraine", "medecin"], ["digestion", "brulures", "attente"],
  ["tension", "elevee", "grave"], ["dos", "lombaires", "attente"], ["sommeil", "endormissement", "medecin"],
  ["allergie", "nez", "attente"], ["bilan", "checkup", "examens"], ["diabete", "soif", "examens"],
];
const page = ([thId, syId, intent]: [string, string, string]) => {
  const th = THEMES.find((x) => x.id === thId)!;
  const sy = th.symptoms.find((x) => x.id === syId)!;
  return { th, sy, intent, href: qPath(lang, th, sy, intent), title: pageTitle(lang, th, sy, intent) };
};
const example = page(["fievre", "seule", "grave"]);
const exampleFiche = fiche("fievre", "seule")!;
const count = await countQuestions().catch(() => 0);
const FAQ = [1, 2, 3, 4, 5, 6] as const;
const EXAMPLE_SECTIONS = [["CircleAlert", "seeQuickly"], ["FileText", "whatToKnow"], ["Hourglass", "meanwhile"], ["Stethoscope", "whichDoctor"], ["Microscope", "exams"], ["MessageCircleQuestion", "askDoctor"]] as const;
const arrow = lang === "ar" ? "ArrowLeft" : "ArrowRight";
const alternates = { fr: `${SITE_URL}/fr`, ar: `${SITE_URL}/ar`, en: `${SITE_URL}/en`, "x-default": `${SITE_URL}/fr` };
const features = [
  { icon: "CircleAlert", title: "seeQuickly", text: "receiveGrave" },
  { icon: "UserRound", title: "yourCase", text: "receiveCase" },
  { icon: "Stethoscope", title: "whichDoctor", text: "receiveDoctor" },
  { icon: "MessageCircleQuestion", title: "askDoctor", text: "receiveQuestions" },
] as const;
---
<Base lang={lang} canonical={`/${lang}`} alternates={alternates} wrap={false}>
  <!-- Héros : titre à gauche, maquette téléphone à droite. -->
  <section class="wrap hero">
    <div>
      <p class="eyebrow">{t(lang, "heroEyebrow")}</p>
      <h1>{t(lang, "tagline")}</h1>
      <p class="lead">{t(lang, "heroSub")}</p>
      <div class="actions">
        <a href={`/${lang}/question`} class="btn btn-primary btn-lg">{t(lang, "startFree")}</a>
        <a href="#exemple" class="btn btn-ghost btn-lg">{t(lang, "seeExample")}</a>
      </div>
      <p class="trust">{t(lang, "trustLine")}</p>
      <div class="quick">
        <span class="muted small">{t(lang, "quickStart")}</span>
        {THEMES.slice(0, 6).map((th) => <a href={`/${lang}/question?theme=${th.id}`} class="chip"><Icon name={th.icon} size={16} />{th.label[lang]}</a>)}
      </div>
    </div>
    <div class="panel art-panel"><PhoneForm className="art" /></div>
  </section>

  <!-- Comment ça marche : trois étapes illustrées. -->
  <section class="band band-neutral" id="comment">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{t(lang, "howEyebrow")}</p>
        <h2>{t(lang, "howTitle")}</h2>
      </div>
      <div class="steps reveal-stagger">
        <article class="step"><div class="step-art"><Choose /></div><div><span class="num">1</span></div><div><h3>{t(lang, "step1Title")}</h3><p class="muted">{t(lang, "step1Text")}</p></div></article>
        <article class="step"><div class="step-art"><Account /></div><div><span class="num">2</span></div><div><h3>{t(lang, "step2Title")}</h3><p class="muted">{t(lang, "step2Text")}</p></div></article>
        <article class="step"><div class="step-art"><AnswerSheet /></div><div><span class="num">3</span></div><div><h3>{t(lang, "step3Title")}</h3><p class="muted">{t(lang, "step3Text")}</p></div></article>
      </div>
    </div>
  </section>

  <!-- Bande bleue : contenu d'une réponse. -->
  <section class="band band-blue">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{t(lang, "receiveEyebrow")}</p>
        <h2>{t(lang, "receiveTitle")}</h2>
      </div>
      <div class="features reveal-stagger">
        {features.map((f) => (
          <div class="feature"><span class="ico"><Icon name={f.icon} size={22} /></span><h4>{t(lang, f.title)}</h4><p>{t(lang, f.text)}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Exemple de réponse : un vrai extrait de fiche, illustré. -->
  <section class="band band-neutral" id="exemple">
    <div class="wrap">
      <div class="example reveal">
        <div>
          <div class="section-head">
            <p class="eyebrow">{t(lang, "exampleEyebrow")}</p>
            <h2>{t(lang, "exampleTitle")}</h2>
            <p class="lead">{t(lang, "exampleText")}</p>
          </div>
          {count > 0 && <p class="counter"><b>{count.toLocaleString(lang === "ar" ? "ar-MA" : "fr-MA")}</b> {t(lang, "counter")}</p>}
        </div>
        <div class="card example-card">
          <div class="example-head">
            <div>
              <p class="muted small" style="margin-bottom:4px">{example.th.label[lang]}</p>
              <h3>{example.title}</h3>
              <p class="summary">{exampleFiche.summary[lang]}</p>
            </div>
            <ThemeArt icon={example.th.icon} className="small" />
          </div>
          <div class="example-timeline">
            <p class="eyebrow" style="margin-bottom:4px">{t(lang, "timelineTitle")}</p>
            <DurationTimeline labels={DURATIONS.map((d) => d.label[lang])} current={1} threshold={example.th.consultAfter}
              youAreHere={t(lang, "youAreHere")} consultFrom={t(lang, "consultFrom")} rtl={lang === "ar"} />
          </div>
          <ul class="example-sections">
            {EXAMPLE_SECTIONS.map(([icon, key]) => <li><Icon name={icon} size={18} />{t(lang, key)}</li>)}
          </ul>
          <a href={example.href} class="btn btn-primary">{t(lang, "readExample")}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sujets -->
  <section class="band">
    <div class="wrap">
      <div class="section-head reveal"><h2>{t(lang, "themesTitle")}</h2></div>
      <div class="grid reveal">
        {THEMES.map((th) => (
          <a href={`/${lang}/question?theme=${th.id}`} class="tile">
            <span class="ico"><Icon name={th.icon} size={24} /></span>
            {th.label[lang]}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Urgence et entraide -->
  <section class="band">
    <div class="wrap" style="display:grid;gap:var(--sec)">
      <div class="split reveal">
        <div>
          <p class="eyebrow">{t(lang, "urgentHomeEyebrow")}</p>
          <h2>{t(lang, "urgentHomeTitle")}</h2>
          <p class="lead">{t(lang, "urgentHomeText")}</p>
        </div>
        <div class="panel panel-red"><Urgent /></div>
      </div>
      <div class="split flip reveal">
        <div>
          <p class="eyebrow">{t(lang, "publicEyebrow")}</p>
          <h2>{t(lang, "publicTitle")}</h2>
          <p class="lead">{t(lang, "publicText")}</p>
        </div>
        <div class="panel panel-purple"><Community /></div>
      </div>
    </div>
  </section>

  <!-- Questions fréquentes -->
  <section class="band band-neutral">
    <div class="wrap">
      <div class="section-head reveal"><h2>{t(lang, "popular")}</h2></div>
      <div class="list-links reveal">
        {POPULAR.map((p) => { const x = page(p); return <a href={x.href}><Icon name={x.th.icon} size={20} />{x.title}</a>; })}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band">
    <div class="wrap faq-wrap">
      <div class="section-head reveal"><h2>{t(lang, "faqTitle")}</h2></div>
      <div class="faq reveal">
        {FAQ.map((n) => (
          <details class="faq-item">
            <summary>{t(lang, `faq${n}q` as "faq1q")}<Icon name="ChevronRight" size={18} /></summary>
            <p>{t(lang, `faq${n}a` as "faq1a")}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Confiance -->
  <section class="band band-tint">
    <div class="wrap cta-final reveal">
      <h2>{t(lang, "trustTitle")}</h2>
      <p class="lead">{t(lang, "trustText")}</p>
      <a href={`/${lang}/question`} class="btn btn-primary btn-lg" style="margin-top:8px">{t(lang, "start")} <Icon name={arrow} size={20} /></a>
    </div>
  </section>
</Base>
