---
import Base from "@/layouts/Base.astro";
import Account from "@/layouts/Account.astro";
import { t } from "@/lib/i18n";
import { langParam } from "@/lib/lang";
import { theme } from "@/lib/content/themes";
import { loadAccount } from "@/lib/account";
import { isEvening, SITE_URL } from "@/lib/site";
import { Chat } from "@/components/Chat";

const lang = langParam(Astro.params);
if (!lang) return Astro.redirect("/fr", 302);
// L'accueil est la conversation elle-même : la première question est posée tout de suite, sans compte.
// ?theme=fievre (liens des pages publiques et du pied de page) répond d'avance à « De quoi s'agit-il ? ».
const th = Astro.url.searchParams.get("theme") ?? "";
const initialTheme = theme(th) ? th : undefined;
const alternates = { fr: `${SITE_URL}/fr`, ar: `${SITE_URL}/ar`, en: `${SITE_URL}/en`, "x-default": `${SITE_URL}/fr` };
// Connecté : la même conversation, dans l'espace patient, avec un bonjour et les questions récentes.
const a = await loadAccount(Astro, lang);
const greeting = a ? t(lang, isEvening() ? "greetEvening" : "greetDay").replace("{name}", a.acc.first_name) : undefined;
---
{a ? (
  <Account lang={lang} active="new" title={t(lang, "newQuestion")} meta={t(lang, "privateAnswers")} name={a.shortName} avatar={a.avatar} recent={a.recent} plain>
    <Chat client:load lang={lang} initialTheme={initialTheme} greeting={greeting} recent={a.recent.slice(0, 3).map((r) => ({ href: `/${lang}/compte/q/${r.id}`, title: r.title }))} />
  </Account>
) : (
  <Base lang={lang} canonical={`/${lang}`} alternates={alternates} wrap={false} footer={false}>
    <Chat client:load lang={lang} initialTheme={initialTheme} />
  </Base>
)}
