---
import Admin from "@/layouts/Admin.astro";
import { adminUser, notAdminUrl, allFiches, reviewedKeys, journal } from "@/lib/admin";

// Journal des actions de l'admin : lecture seule, rien ne s'efface d'ici (CNDP, données de santé).
const user = await adminUser(Astro.cookies);
if (!user) return Astro.redirect(await notAdminUrl(Astro.cookies, "/admin/journal"), 302);
const rows = await journal(200);
const toReview = allFiches().length - (await reviewedKeys()).size;
const when = (x: string | Date) => new Date(x).toLocaleString("fr-FR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit", timeZone: "Africa/Casablanca" });
---
<Admin user={user} active="journal" title="Journal" counts={{ toReview }}>
  <div class="adm-top"><h1>Journal</h1><span class="adm-note">Chaque action de l'admin est notée ici et ne peut pas être effacée.</span></div>
  {rows.length ? (
    <div class="adm-table">
      <table>
        <thead><tr><th>Quand</th><th>Qui</th><th>Action</th><th>Sur</th></tr></thead>
        <tbody>{rows.map((r) => <tr><td class="adm-nowrap">{when(r.at)}</td><td>{r.who}</td><td>{r.action}</td><td>{r.target}</td></tr>)}</tbody>
      </table>
    </div>
  ) : <p class="adm-empty">Aucune action pour l'instant.</p>}
</Admin>
